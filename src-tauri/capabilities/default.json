{
  "$schema": "../gen/schemas/desktop-capability.schema.json",
  "identifier": "default",
  "description": "Default permissions for the desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "sidecar": "binaries/backend"
        }
      ]
    }
  ]
}